{
  "name": "@voxolith/gen-kit",
  "version": "0.1.0",
  "description": "Authoring toolkit for Voxolith generators: volumes, rasterisers, noise, branch growth, canopy carving, rock masses, and a headless preview renderer",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/voxolith/generators.git", "directory": "kit" },
  "homepage": "https://github.com/voxolith/generators/tree/main/kit#readme",
  "bugs": "https://github.com/voxolith/generators/issues",
  "keywords": ["voxel", "procedural", "generator", "toolkit", "voxolith"],
  "files": ["src", "README.md"],
  "exports": { ".": "./src/index.ts", "./preview": "./src/preview/index.ts" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "bun tools/verify.ts"
  },
  "dependencies": { "@voxolith/engine": "workspace:*", "@voxolith/renderer": "workspace:*" },
  "devDependencies": { "@types/node": "^26.6.2", "typescript": "^7.0.2" }
}

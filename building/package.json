{
  "name": "@voxolith/gen-building",
  "version": "0.1.0",
  "description": "Procedural voxel buildings for Voxolith: a small shape grammar for cottages, farmhouses, townhouses and towers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/voxolith/generators.git", "directory": "building" },
  "homepage": "https://github.com/voxolith/generators/tree/main/building#readme",
  "bugs": "https://github.com/voxolith/generators/issues",
  "keywords": ["voxel", "building", "house", "architecture", "procedural", "generator", "voxolith"],
  "files": ["src", "README.md"],
  "exports": { ".": "./src/index.ts" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "bun tools/verify.ts",
    "preview": "bun tools/preview.ts",
    "gen": "bun tools/gen.ts"
  },
  "dependencies": { "@voxolith/engine": "workspace:*", "@voxolith/gen-kit": "workspace:*", "@voxolith/renderer": "workspace:*" },
  "devDependencies": { "@types/node": "^26.6.2", "typescript": "^7.0.2" }
}

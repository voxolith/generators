{
  "name": "@voxolith/generators",
  "private": true,
  "type": "module",
  "description": "Pluggable entity generators for the Voxolith voxel engine. Each folder publishes its own package.",
  "workspaces": [
    "creature",
    "contract",
    "terrain",
    "kit",
    "tree",
    "bush",
    "grass",
    "rock",
    "building"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "verify": "bun run --filter '*' verify",
    "preview": "bun run --filter '*' preview"
  }
}
